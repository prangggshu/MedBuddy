# ──────────────────────────────────────────────────────────────
# MedBuddy configuration — copy to `.env` and fill in what you use.
# Proof-of-concept. NOT for clinical use.
# ──────────────────────────────────────────────────────────────

APP_ENV=dev

# ─── Database ─────────────────────────────────────────────────
# SQLite for local dev (default); PostgreSQL for deployment.
DATABASE_URL=sqlite:///./medbuddy.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/medbuddy

# ─── LLM: provider-agnostic via LiteLLM ───────────────────────
# Model strings use LiteLLM format: "<provider>/<model>".
# Per-role models — swap freely across providers:
#   AGENT_MODEL       the tool-use loop. MUST do reliable function-calling.
#                     Small/free models often fail here — keep this a capable one.
#   VISION_MODEL      image -> structured extraction. MUST support vision.
#   EXPLANATION_MODEL plain-language rephrasing. Cheap / free is fine.
#
# ⚠ The strings below are EXAMPLES — provider model names drift over time.
#   Verify current names in each provider's / LiteLLM's docs before relying on them.
AGENT_MODEL=gemini/gemini-3.8-flash
VISION_MODEL=gemini/gemini-3.8-flash
EXPLANATION_MODEL=gemini/gemini-3.8-flash

# Optional comma-separated fallbacks used if the primary model errors / rate-limits.
LLM_FALLBACKS=

# Provider API keys — set ONLY the ones your chosen models actually use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ─── Web chat ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
DEMO_MODE=false

# ─── Reminders ────────────────────────────────────────────────
# Minutes to wait for a "taken/missed" reply before sending a missed-dose nudge.
MISSED_DOSE_WINDOW_MIN=60

# Patients' local time as a fixed UTC offset in minutes (IST = 330).
TZ_OFFSET_MINUTES=330

# ─── Agent ────────────────────────────────────────────────────
# LangGraph conversation state (separate from app data — safe to delete to reset chats).
CHECKPOINT_DB=./checkpoints.db
AGENT_RECURSION_LIMIT=25
# Photo replies: "template" = built only from tool results (1 LLM call per photo)
#                "rephrase" = template rewritten warmly by EXPLANATION_MODEL (2 calls)
PHOTO_REPLY_MODE=template

